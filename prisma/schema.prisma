generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
  CLIENT
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
  LINKEDIN
  YOUTUBE
  THREADS
  PINTEREST
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model User {
  id        String   @id // Supabase auth user id
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WorkspaceMember[]
  assets      MediaAsset[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  brands   Brand[]
  accounts SocialAccount[]
  posts    Post[]
  assets   MediaAsset[]
  inbox    InboxMessage[]
  reports  Report[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Brand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?  // hex
  logoUrl     String?
  voice       String?  // tone notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]
  accounts  SocialAccount[]
}

model SocialAccount {
  id              String        @id @default(cuid())
  workspaceId     String
  brandId         String?
  platform        Platform
  platformUserId  String
  username        String?
  displayName     String?
  avatarUrl       String?
  accessToken     String        // encrypted at app layer
  refreshToken    String?
  tokenExpiresAt  DateTime?
  scopes          String?
  status          AccountStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  posts     PostPlatform[]

  @@unique([workspaceId, platform, platformUserId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  url         String
  thumbnailUrl String?
  type        String   // image | video
  mimeType    String?
  size        Int?     // bytes
  width       Int?
  height      Int?
  duration    Int?     // seconds for video
  tags        String[]
  folder      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     PostMedia[]
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  brandId     String?
  title       String?
  caption     String     @default("")
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdBy   String?    // userId
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platforms   PostPlatform[]
  media       PostMedia[]
  comments    PostComment[]
}

model PostPlatform {
  id             String     @id @default(cuid())
  postId         String
  accountId      String
  platform       Platform
  content        String     // platform-specific caption
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  publishedUrl   String?
  platformPostId String?
  errorMessage   String?
  metrics        Json?      // { likes, comments, shares, reach, impressions, saves }
  metricsUpdatedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  assetId String
  order   Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([postId, assetId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model InboxMessage {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String?
  platform      Platform
  type          String   // comment | dm | mention
  externalId    String
  authorName    String?
  authorAvatar  String?
  content       String
  permalink     String?
  isRead        Boolean  @default(false)
  isReplied     Boolean  @default(false)
  replyText     String?
  receivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, externalId])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String?
  platform    Platform
  date        DateTime
  followers   Int?
  reach       Int?
  impressions Int?
  engagement  Int?
  clicks      Int?
  data        Json?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, platform, date, accountId])
}

model Report {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String   // weekly | monthly | custom
  periodStart DateTime
  periodEnd   DateTime
  fileUrl     String?
  status      String   @default("pending") // pending | ready | failed
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model HashtagSet {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  tags        String[]
  createdAt   DateTime @default(now())
}