# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres)
# IMPORTANT: Railway (and many PaaS) cannot reach Supabase direct DB (IPv6-only).
# Use the Supabase POOLER for BOTH URLs:
#   DATABASE_URL  -> Transaction pooler (port 6543)  -> app queries
#   DIRECT_URL    -> Session pooler      (port 5432)  -> migrations
# Get both from Supabase → Settings → Database → Connection string
# (Transaction mode & Session mode). Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENCRYPTION_KEY= # 32 byte hex for token encryption

# Scheduler (Railway persistent server). Set true if running a single replica.
# If using an external cron hitting /api/cron/publish, leave false.
ENABLE_INTERNAL_SCHEDULER=false

# Social platforms (OAuth) - fill as needed
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Cron secret (Vercel cron auth)
CRON_SECRET=